# ─────────────────────────────────────────────────────────────
# AWS — DynamoDB credentials
# Use a dedicated IAM user with ONLY DynamoDB access scoped to
# the fep-* tables. Never use root keys.
# ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_XXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# JWT — auth signing secret
# Generate with: openssl rand -base64 64
# Must be at least 32 bytes for HS256 to be safe.
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Gradi AI — video analysis service
# Default endpoint works as-is, override only if pointed elsewhere.
# ─────────────────────────────────────────────────────────────
GRADI_API_URL=https://gradi.ai/api/analyze-video

# ─────────────────────────────────────────────────────────────
# Google OAuth — Sign in with Google
# Get from: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────
# YouTube Data API — video stats sync (server-side scripts/routes)
# Get from: https://console.cloud.google.com/apis/credentials
# Use a SEPARATE, HTTP-referrer-restricted key for
# NEXT_PUBLIC_YOUTUBE_API_KEY below — anything NEXT_PUBLIC_ ships
# in the browser bundle, so it must not be the same unrestricted
# key used server-side.
# ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-server-side-youtube-api-key
NEXT_PUBLIC_YOUTUBE_API_KEY=your-referrer-restricted-youtube-api-key

# ─────────────────────────────────────────────────────────────
# Orders → cohort auto-sync
# Shared secret between the Campus Program Google Sheet's Apps Script
# and POST /api/cohorts/sync-orders. Generate with: openssl rand -hex 32
# Set the SAME value in the Apps Script (Project Settings → Script
# Properties → ORDERS_SYNC_SECRET). See scripts/apps-script/sync-orders.gs
# ─────────────────────────────────────────────────────────────
ORDERS_SYNC_SECRET=replace-with-a-long-random-string

# ─────────────────────────────────────────────────────────────
# Phone OTP (password reset / verification)
# Pick ONE provider (auto-detected by which key is present). With none
# set, the OTP service runs in dev mode: the code is logged server-side
# and returned in the API response (non-production only) for local testing.
#
# Option A — Fast2SMS (free signup credits, simplest, India OTP route):
#   Sign up at fast2sms.com → Dev API → copy the API key. No template needed.
FAST2SMS_API_KEY=your-fast2sms-api-key
#
# Option B — MSG91 (enterprise; needs a DLT-approved OTP template):
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-msg91-otp-template-id
# MSG91_SENDER_ID=EDUSKL

# ─────────────────────────────────────────────────────────────
# Public (browser-readable) — branding
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FEP
NEXT_PUBLIC_BRAND=Adda247
